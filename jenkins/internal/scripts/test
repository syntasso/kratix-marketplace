#!/usr/bin/env bash
set -e

test_promise() {
  kubectl --context kind-worker get crds jenkins.jenkins.io
  kubectl --context kind-worker wait --for=condition=Available --timeout=5s deployment/jenkins-operator
}

test_resource_request() {
  kubectl --context kind-worker wait --for=condition=ready --timeout=5s pod/jenkins-dev-example
}

if [ "$1" = "promise" ]; then
  test_promise
else
  test_resource_request
fi
